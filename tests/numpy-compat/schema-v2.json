{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:menudet:numpy-vectors:2",
  "title": "Language-independent Menudet numerical conformance vectors, version 2",
  "type": "object",
  "required": ["schema_version", "generator_revision", "reference", "provenance", "cases"],
  "properties": {
    "schema_version": {"const": "menudet-numpy-vectors-2"},
    "generator_revision": {"type": "string"},
    "reference": {
      "type": "object",
      "required": ["numpy", "intp_bits", "byteorder", "platform", "machine", "floating_errors", "python"],
      "properties": {"numpy": {"type": "string"}, "intp_bits": {"enum": [32, 64]}, "byteorder": {"enum": ["little", "big"]}, "floating_errors": {"const": "ignore"}}
    },
    "provenance": {"type": "object", "required": ["checkpoint_schema", "rng", "seeds"], "properties": {"rng": {"const": "NumPy PCG64"}, "seeds": {"type": "array", "items": {"type": "integer"}}}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "layout": {
      "type": "object", "required": ["order", "byteorder", "step", "reverse_axis"], "additionalProperties": false,
      "properties": {
        "order": {"enum": ["C", "F"]}, "byteorder": {"enum": ["native", "little", "big"]},
        "step": {"type": "integer", "minimum": 1, "maximum": 4},
        "reverse_axis": {"type": ["integer", "null"], "minimum": 0, "maximum": 7}
      }
    },
    "buffer": {
      "type": "object", "required": ["dtype", "shape", "encoding", "hex"],
      "properties": {
        "dtype": {"enum": ["bool", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "complex64"]},
        "shape": {"type": "array", "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 4096}},
        "encoding": {"const": "raw-be-hex"}, "hex": {"type": "string", "pattern": "^([0-9a-f]{2})*$"},
        "name": {"type": "string"}, "category": {"enum": ["array", "zero_dimensional_array", "typed_scalar"]},
        "layout": {"$ref": "#/$defs/layout"},
        "classes": {"type": "array", "items": {"enum": ["finite", "subnormal", "positive_zero", "negative_zero", "nan", "positive_inf", "negative_inf"]}}
      }
    },
    "diagnostic": {
      "type": "object", "required": ["diagnostic"],
      "properties": {"diagnostic": {"type": "object", "required": ["category"], "properties": {"category": {"enum": ["invalid_artifact", "unsupported_requirement", "invalid_source", "binding_error", "evaluation_error", "out_of_memory"]}, "numpy_category": {"type": "string"}}}}
    },
    "comparison": {
      "type": "object", "required": ["kind", "atol", "rtol", "max_ulp", "nan", "signed_zero"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["bitwise", "exact", "ulp", "tolerance"]},
        "atol": {"type": "number", "minimum": 0}, "rtol": {"type": "number", "minimum": 0},
        "max_ulp": {"type": "integer", "minimum": 0}, "nan": {"enum": ["bits", "equal"]}, "signed_zero": {"enum": ["exact", "ignore"]}
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "operation", "semantic_revision", "requires", "artifact", "inputs", "scalar_operands", "literal", "expected", "comparison", "reference_kind", "seed"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "operation": {"type": "string"},
        "semantic_revision": {"enum": ["menudet-draft-1.0-checked", "menudet-numpy-1.1"]},
        "requires": {"type": "array", "items": {"type": "string"}},
        "artifact": {"type": "string", "description": "Complete normalized kernel artifact, independently validated by the native runtime"},
        "inputs": {"type": "array", "maxItems": 16, "items": {"allOf": [{"$ref": "#/$defs/buffer"}, {"required": ["name", "category", "layout"]}]}},
        "scalar_operands": {"type": "array", "items": {"$ref": "#/$defs/buffer"}},
        "literal": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["category", "type", "decimal"], "properties": {"category": {"const": "weak"}, "type": {"enum": ["int", "float"]}, "decimal": {"type": "string"}}}]},
        "expected": {"oneOf": [{"$ref": "#/$defs/buffer"}, {"$ref": "#/$defs/diagnostic"}]},
        "reference_expected_by_machine": {"type": "object", "description": "Reviewed exact host-specific NumPy observations; native expected/baseline remain unchanged", "additionalProperties": {"$ref": "#/$defs/buffer"}},
        "comparison": {"$ref": "#/$defs/comparison"},
        "reference_kind": {"enum": ["numpy", "native-contract"]}, "seed": {"type": ["integer", "null"]},
        "baseline": {"type": "object", "required": ["status", "category"], "properties": {"status": {"type": "integer"}, "category": {"type": "string"}, "output": {"$ref": "#/$defs/buffer"}}},
        "classification": {"enum": ["matching", "divergent", "unsupported", "unverified"]},
        "divergence": {"type": "object", "required": ["id", "reason"], "properties": {"id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}},
        "recovery": {"type": "object", "required": ["inputs", "expected"], "properties": {"inputs": {"type": "array", "items": {"$ref": "#/$defs/buffer"}}, "expected": {"$ref": "#/$defs/buffer"}}},
        "skip_reason": {"type": "string"}, "minimized_from": {"type": "string"}, "platform_qualification": {"type": "string"}
      }
    }
  }
}
