{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Menudet explicit materialized stages 1 (experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "semantics", "requires", "inputs", "stages", "root"],
  "properties": {
    "format": {"const": "menudet-staged-graph-1"},
    "semantics": {"const": "menudet-numpy-1.1"},
    "requires": {"const": ["numeric", "staged"]},
    "inputs": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "dtype"],
        "properties": {"name": {"$ref": "native-graph-1.schema.json#/$defs/name"}, "dtype": {"$ref": "native-graph-1.schema.json#/$defs/dtype"}}
      }
    },
    "stages": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/stage"}},
    "root": {"type": "integer", "minimum": 0, "maximum": 31}
  },
  "$defs": {
    "bindings": {
      "type": "object", "maxProperties": 32,
      "propertyNames": {"$ref": "native-graph-1.schema.json#/$defs/name"},
      "additionalProperties": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["input"], "properties": {"input": {"$ref": "native-graph-1.schema.json#/$defs/name"}}},
          {"type": "object", "additionalProperties": false, "required": ["stage"], "properties": {"stage": {"type": "integer", "minimum": 0, "maximum": 30}}}
        ]
      }
    },
    "stage": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "inputs", "graph"],
          "properties": {
            "id": {"type": "integer", "minimum": 0, "maximum": 31}, "kind": {"const": "graph"},
            "inputs": {"$ref": "#/$defs/bindings"}, "graph": {"$ref": "native-graph-1.schema.json"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "inputs", "artifact", "contract"],
          "properties": {
            "id": {"type": "integer", "minimum": 0, "maximum": 31}, "kind": {"const": "portable"},
            "inputs": {"$ref": "#/$defs/bindings"}, "artifact": {"type": "object"},
            "contract": {"const": {"cardinality": "elementwise", "context": "none", "effects": "ordered-lazy", "mask": "none"}}
          }
        }
      ]
    }
  },
  "$comment": "Native validation enforces exact signatures, portable 1.1 profile/capabilities, ordered dependency references, last-stage root, reachability, nonnested stage graphs and shape/materialization budgets. No executable cached inference or arbitrary callback nodes."
}
