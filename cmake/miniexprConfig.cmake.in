@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT EMSCRIPTEN)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/miniexprTargets.cmake")

if(NOT TARGET miniexpr::core)
  if(TARGET miniexpr::miniexpr)
    add_library(miniexpr::core INTERFACE IMPORTED)
    set_target_properties(miniexpr::core PROPERTIES INTERFACE_LINK_LIBRARIES "miniexpr::miniexpr")
  elseif(TARGET miniexpr::miniexpr_static)
    add_library(miniexpr::core INTERFACE IMPORTED)
    set_target_properties(miniexpr::core PROPERTIES INTERFACE_LINK_LIBRARIES "miniexpr::miniexpr_static")
  endif()
endif()

foreach(_component IN ITEMS core artifact)
  if(TARGET miniexpr::${_component})
    set(miniexpr_${_component}_FOUND TRUE)
  else()
    set(miniexpr_${_component}_FOUND FALSE)
  endif()
endforeach()
unset(_component)
check_required_components(miniexpr)
